public class GradeChecker {

    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        
        double averageGrade = 82.5;
        int absences = 2;
        
        boolean hasPassed = (averageGrade >= 75 && absences <= 3) || (averageGrade >= 90);
        
        if (hasPassed) {
            System.out.println("PASS: You did well!");
        } else {
            System.out.println("FAIL: You did not meet the required average and attendance thresholds");
        }
    }
}
